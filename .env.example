# DeshiA local configuration (all optional; sensible defaults are used).
#
# Location of the SQLite database file. Defaults to ./.deshia/deshia.db
# DESHIA_DB_PATH=./.deshia/deshia.db
#
# Set to 1 to enable the plain path-input fallback for folder selection when
# not running inside Tauri (used by the browser dev server and E2E tests).
# DESHIA_E2E=0
